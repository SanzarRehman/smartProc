# Procurement Email Automation - Environment Variables Template
# Copy this file to .env and fill in your actual values
# Then run: source .env

# ============================================
# Email Configuration (REQUIRED)
# ============================================
# For Gmail:
# 1. Enable IMAP in Gmail settings
# 2. If 2FA is enabled, generate an App Password:
#    Google Account → Security → 2-Step Verification → App passwords
# 3. Use the App Password as EMAIL_PASSWORD

export EMAIL_HOST=imap.gmail.com
export EMAIL_PORT=993
export EMAIL_USERNAME=your-email@gmail.com
export EMAIL_PASSWORD=your-app-password-here
export EMAIL_PROTOCOL=imaps

# ============================================
# Gemini API Configuration (REQUIRED)
# ============================================
# Get your API key from: https://makersuite.google.com/app/apikey

export GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
export GEMINI_API_KEY=your-gemini-api-key-here

# ============================================
# Keycloak Configuration (OPTIONAL for POC)
# ============================================
# The system will work without Keycloak using default user context
# To run Keycloak locally:
# docker run -p 8080:8080 -e KEYCLOAK_ADMIN=admin -e KEYCLOAK_ADMIN_PASSWORD=admin quay.io/keycloak/keycloak:latest start-dev

export KEYCLOAK_URL=http://localhost:8080
export KEYCLOAK_REALM=procurement
export KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# ============================================
# Application Configuration (OPTIONAL)
# ============================================
# Uncomment to customize

# export EMAIL_POLLING_INTERVAL=60000  # Poll every 60 seconds
# export EMAIL_MAX_MESSAGES_PER_POLL=10
